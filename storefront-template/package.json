  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "convex-test": "^0.0.37",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
