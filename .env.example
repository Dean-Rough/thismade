# Convex
# Set by `npx convex dev` once authenticated against a real deployment.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Stripe — test mode only (sk_test_...). Never set a live secret key in this build.
STRIPE_SECRET_KEY=
# Signing secret for the /api/webhooks/stripe endpoint (whsec_...), from the
# Stripe CLI (`stripe listen`) or a test-mode webhook endpoint in the dashboard.
STRIPE_WEBHOOK_SECRET=

# This app's own base URL, used to build Stripe Connect onboarding-link
# refresh/return redirects. Example: http://localhost:3000 in dev.
NEXT_PUBLIC_APP_URL=

# Shared secret gating every Convex function's public *Actions.ts fronting
# layer (see convex/lib/serviceAuth.ts, THI-42/56/58/63). Required for every
# Convex deployment this app talks to — never committed here as a value,
# only documented as a required var (this was previously undocumented, a
# pre-existing gap found while building THI-68).
CONVEX_SERVICE_SECRET=

# Phase 3 (THI-68): sandboxed worker-execution loop. Not provisioned in the
# environment this loop was built in — a dispatched task fails gracefully
# (logged as a typed `error` event, recordAttemptFailure'd) rather than
# hanging when either is unset. See DECISIONS.md's THI-68 entry.
#
# E2B sandbox (coding/browser workers only — marketing workers never
# provision one, see convex/lib/workerTools.ts).
E2B_API_KEY=
# Vercel AI Gateway credential for the worker LLM loop (convex/lib/llmClient.ts).
# Confirmed live: an unset key surfaces exactly this AI SDK error —
# "Unauthenticated. Configure AI_GATEWAY_API_KEY or use a provider module."
AI_GATEWAY_API_KEY=
# Optional override for the worker loop's model, as a Gateway "provider/model"
# string. Defaults to anthropic/claude-sonnet-5 if unset.
WORKER_LLM_MODEL=
