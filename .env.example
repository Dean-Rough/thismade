# Convex
# Set by `npx convex dev` once authenticated against a real deployment.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk (dashboard auth) — test-mode keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe — test mode only (sk_test_...). Never set a live secret key in this build.
STRIPE_SECRET_KEY=
# Signing secret for the /api/webhooks/stripe endpoint (whsec_...), from the
# Stripe CLI (`stripe listen`) or a test-mode webhook endpoint in the dashboard.
STRIPE_WEBHOOK_SECRET=

# This app's own base URL, used to build Stripe Connect onboarding-link
# refresh/return redirects. Example: http://localhost:3000 in dev.
NEXT_PUBLIC_APP_URL=
